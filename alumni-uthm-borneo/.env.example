# ─── Site ─────────────────────────────────────────────────────────
# Public URL with no trailing slash. Used for ToyyibPay return/callback URLs.
NEXT_PUBLIC_SITE_URL=https://alumni-uthm-borneo.netlify.app
# Shown on the footer "Contact" link.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Supabase (server only, never expose the service role key) ───
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── ToyyibPay ────────────────────────────────────────────────────
# Sandbox: https://dev.toyyibpay.com   Production: https://toyyibpay.com
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# 0 = FPX only, 1 = card only, 2 = FPX + card.
# Card needs separate activation on the ToyyibPay account (RM100 onboarding + RM100/year).
TOYYIBPAY_PAYMENT_CHANNEL=0
# Blank = all fees on bill owner. 0 = FPX fee on payer. 1 = card fee on payer. 2 = all fees on payer.
TOYYIBPAY_CHARGE_TO_CUSTOMER=
# 1 = also offer DuitNow QR on the ToyyibPay page (needs DuitNow QR activated on the account;
# if it isn't, bills fall back to online banking automatically).
TOYYIBPAY_DUITNOW_QR=0
# Who pays the DuitNow QR fee: 0 = bill owner, 1 = payer.
TOYYIBPAY_DUITNOW_QR_CHARGE=0

# ─── Email (receipts) ─────────────────────────────────────────────
# resend | brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
# Must be a verified sender/domain on your email provider.
EMAIL_FROM_NAME=Alumni UTHM Borneo
EMAIL_FROM_ADDRESS=receipts@your-verified-domain.com
EMAIL_REPLY_TO=
# Optional: a secretariat inbox that receives a copy of every receipt.
EMAIL_BCC=

# ─── Admin ────────────────────────────────────────────────────────
# Long random password for /admin. Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
