# ─── Site ─────────────────────────────────────────────────────────
# Public URL with no trailing slash. Used for ToyyibPay return/callback URLs.
NEXT_PUBLIC_SITE_URL=https://alumni-uthm-borneo.netlify.app
# Shown on the footer "Contact" link.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Supabase (server only, never expose the service role key) ───
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments ─────────────────────────────────────────────────────
# Payers use DuitNow QR / bank transfer to KOBIS Berhad and upload proof.
# Bank details and the QR image live in content/site.ts and public/images/.
# Optional: inbox that gets an email whenever a proof of payment is uploaded.
ADMIN_NOTIFY_EMAIL=

# ─── Email (receipts) ─────────────────────────────────────────────
# resend | brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
# Must be a verified sender/domain on your email provider.
EMAIL_FROM_NAME=Alumni UTHM Borneo
EMAIL_FROM_ADDRESS=receipts@your-verified-domain.com
EMAIL_REPLY_TO=
# Optional: a secretariat inbox that receives a copy of every receipt.
EMAIL_BCC=

# ─── Admin ────────────────────────────────────────────────────────
# Long random password for /admin. Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
