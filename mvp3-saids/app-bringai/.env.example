# WhatsApp destination for the Snapshot handoff, country code, digits only.
# The default in code is a deliberately invalid placeholder so a demo build can
# never dial a real stranger's line. The WhatsApp CTA stays hidden until this is set.
VITE_WHATSAPP_NUMBER=60000000000

# Booking link for the RM 1,500 Potential Readout (Cal.com or Calendly).
# The scan ID is appended as ?scan=... so the call opens with the report in hand.
# The CTA stays hidden until this is set.
VITE_BOOKING_URL=

# Supabase capture. The email form only renders when BOTH are present — a form
# that promises to send a copy and silently drops it is worse than no form.
# Table `scans`, insert-only via the anon key, RLS permitting insert, denying select.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
