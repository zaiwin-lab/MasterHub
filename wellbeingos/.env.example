# WellbeingOS — environment configuration
# The MVP runs against a seeded in-browser data layer (see docs/ARCHITECTURE.md).
# These variables are the documented swap points for a hosted backend.

# Active tenant for this deployment (see src/tenants/registry.ts)
NEXT_PUBLIC_DEFAULT_TENANT=stidc

# Show the demo persona switcher on the sign-in screen. Set to false for pilots.
NEXT_PUBLIC_ENABLE_DEMO_PERSONAS=true

# --- Backend (not required for the MVP demo build) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only — never expose to the browser

# --- Integration adapters (LAYER D) — mocked until credentials are supplied ---
# HRIS_ADAPTER=mock
# CLINIC_ADAPTER=mock
# NOTIFY_ADAPTER=mock
