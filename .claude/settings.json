{
  "permissions": {
    "allow": [
      "Bash(buzz)",
      "Bash(buzz *)",
      "Bash(buzz:*)",
      "PowerShell(buzz)",
      "PowerShell(buzz *)",

      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "agentmemory": {
      "command": "node",
      "args": [
        "C:\\Users\\user\\AppData\\Roaming\\npm\\node_modules\\@agentmemory\\agentmemory\\dist\\cli.mjs",
        "mcp"
      ],
      "env": {
        "AGENTMEMORY_III_PATH": "C:\\Users\\user\\.local\\bin\\iii.exe"
      }
    }
  }
}
